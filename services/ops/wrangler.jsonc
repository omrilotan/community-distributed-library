{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Logs, traces and Issues. A deploy sets the sampling rates from the
  // manifest (scripts/libraries.mjs); query strings stay out.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  "upload_source_maps": true,
  // The operator's MCP server at ops.<domain>/mcp, and the inbox Cloudflare
  // posts alerts to (src/index.ts). A deploy adds the route and a binding to
  // each library's core (scripts/libraries.mjs).
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdl-ops",
      // Local only; the fleet's comes from the manifest (shared.ops).
      "database_id": "00000000-0000-4000-8000-0000000000e5",
      "migrations_dir": "migrations",
    },
  ],
  // Grants and client registrations of MCP clients that sign in with the
  // operator's key (src/signin.ts). Local only; the fleet's comes from the
  // manifest (shared.ops.oauthKv).
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000040008000000000000e5a" },
  ],
  // Per caller address: client registrations, and tries at the key.
  "ratelimits": [
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "SIGNIN_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // The cdl_events dataset and Workers Logs, read without an API token.
  "analytics": { "binding": "ANALYTICS_SQL" },
  // The weekly digest, and the failure alerts it relays (src/relay.ts).
  "send_email": [{ "name": "EMAIL" }],
  // Mondays, 08:00 UTC: the weekly digest (src/digest.ts).
  "triggers": { "crons": ["0 8 * * 1"] },
  "vars": {
    // This Worker's public origin; a deploy writes https://<ops host>.
    "SELF_URL": "http://localhost:8789",
    // The libraries, as [{ slug, host, binding, sampling }]; a deploy writes it.
    "LIBRARIES": "[]",
    // The digest's sender: an address on a domain that sends (the first library's).
    "FROM_ADDRESS": "",
    // The operator's address (scripts/observe.mjs --email): told of every
    // failure, besides the library's admins. A deploy writes it.
    "ALERTS_EMAIL": "",
  },
}
