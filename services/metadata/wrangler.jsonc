{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-metadata",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Logs, traces and Issues. A deploy sets the sampling rates for each library
  // and Worker from the manifest (scripts/libraries.mjs); query strings stay
  // out, so a search never reaches the logs.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  // Stack traces of uncaught exceptions name src/ files, not the bundle.
  "upload_source_maps": true,
  // Internal, and shared: reached only by each library's core, over its service binding.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdl-metadata",
      // Local only; the shared one comes from the manifest.
      "database_id": "00000000-0000-4000-8000-0000000e7a0a",
      "migrations_dir": "migrations",
    },
  ],
}
