{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // Browsers post here directly, from any page of any community.
  "workers_dev": false,
  "preview_urls": false,
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "CDL_REPORTS" },
  ],
}
