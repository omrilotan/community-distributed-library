{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Stack traces of uncaught exceptions name src/ files, not the bundle.
  "upload_source_maps": true,
  // Internal: reached only by core over its service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Email Sending: the domain of FROM_ADDRESS must be enabled
  // for sending (`wrangler email sending enable <domain>`).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "FROM_ADDRESS": "library@example.org",
    // Web push. The private half is a secret on this Worker.
    "VAPID_PUBLIC_KEY": "",
    "FROM_NAME": "Local Library",
  },
}
