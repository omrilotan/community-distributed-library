{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Logs, traces and Issues. A deploy sets the sampling rates for each library
  // and Worker from the manifest (scripts/libraries.mjs); query strings stay
  // out, so a search never reaches the logs.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  // Stack traces of uncaught exceptions name src/ files, not the bundle.
  "upload_source_maps": true,
  // Daily reminders (reminders.ts); every minute, new loan requests whose
  // owners are due to hear of them, webhook retries and follow-up emails
  // (notify.ts, events.ts); a database snapshot overnight (backup.ts).
  "triggers": { "crons": ["0 8 * * *", "* * * * *", "20 3 * * *"] },
  // No public URL: only the web Worker reaches core, over the service binding.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdl-core",
      // Local only; a library's own comes from its manifest.
      "database_id": "00000000-0000-4000-8000-00000000c0e1",
      "migrations_dir": "migrations",
    },
  ],
  "services": [
    { "binding": "METADATA", "service": "cdl-metadata" },
    { "binding": "NOTIFY", "service": "cdl-notify" },
    { "binding": "CONVO", "service": "cdl-convo" },
  ],
  "r2_buckets": [
    { "binding": "COVERS", "bucket_name": "cdl-images" },
    // Private: nightly SQL snapshots (backup.ts). Never served.
    { "binding": "BACKUPS", "bucket_name": "cdl-backups" },
  ],
  "vars": {
    // Origin the web app is served from; magic links and invites point here.
    "APP_URL": "http://localhost:3000",
    // Web push. The private half is a secret on the notify Worker.
    "VAPID_PUBLIC_KEY": "",
    // Where the images bucket is served. Locally core serves uploads itself.
    "COVERS_PUBLIC_URL": "http://localhost:8787/v1/covers",
    // Where the contact form's messages go: a person, not a queue.
    "CONTACT_ADDRESS": "library@example.org",
    // What cdl_events names this library by, and how it samples reads
    // (src/telemetry.ts). A deploy writes them from the manifest.
    "LIBRARY": "local",
    "DEPLOYED_AT": "",
    "READS_SAMPLE_RATE": "",
    "SAMPLING_BOOST_UNTIL": "",
  },
  // Counts for the dashboards and the ops tools, one dataset for every
  // library (src/telemetry.ts).
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "cdl_events" },
  ],
}
