{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cdl-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Stack traces of uncaught exceptions name src/ files, not the bundle.
  "upload_source_maps": true,
  // Public: MCP clients connect here. It holds no data and no logic of its
  // own — every tool is a call to core's public API with the member's token.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000040008000000000000a07" },
  ],
  // Client registrations per caller address: five a minute. The namespace
  // is the account's, shared by every library's MCP Worker.
  "ratelimits": [
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "services": [
    { "binding": "CORE", "service": "cdl-core" },
    {
      "binding": "CORE_INTERNAL",
      "service": "cdl-core",
      "entrypoint": "Internal",
    },
  ],
  "vars": {
    "APP_URL": "http://localhost:3000",
    "SELF_URL": "http://localhost:8788",
  },
}
